# Synthetic local values only. Copy to .env if you need to override defaults.
APP_ENV=development
SERVICE_MODE=mock
DATABASE_URL=postgresql://beacon_app:local-development-only@127.0.0.1:15432/beacon
REDIS_URL=redis://127.0.0.1:16379
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=beacon-example
PUBLIC_API_URL=http://127.0.0.1:3002
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
# Auth0: runtime only; mock development and existing staging remain closed until activation.
AUTH_ENABLED=false
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
AUTH0_AUTH_BINDINGS=[]
