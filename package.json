{
  "name": "roaswell",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:infra": "docker compose -f infra/local/compose.yaml up -d --wait --wait-timeout 180",
    "dev:infra:stop": "docker compose -f infra/local/compose.yaml stop",
    "dev:infra:status": "docker compose -f infra/local/compose.yaml ps",
    "lint": "node node_modules/@biomejs/biome/bin/biome check .",
    "typecheck": "turbo typecheck",
    "test": "vitest run --project unit",
    "test:integration": "pnpm --filter @roaswell/worker build && vitest run --project integration",
    "test:e2e": "node scripts/playwright.mjs test",
    "build": "turbo build",
    "storybook": "pnpm --filter @roaswell/ui storybook",
    "build:storybook": "pnpm --filter @roaswell/ui build:storybook",
    "test:startup": "node scripts/check-startup.mjs",
    "browser:install": "node scripts/playwright.mjs install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@scalar/openapi-parser": "0.29.9",
    "@temporalio/client": "1.24.0",
    "@types/node": "22.19.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "redis": "6.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
