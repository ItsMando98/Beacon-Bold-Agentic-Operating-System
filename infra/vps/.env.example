# Public configuration only; secrets belong in the separate private directory.
BEACON_RELEASE=
BEACON_SECRETS_DIR=/opt/beacon-bold-staging/secrets

# Auth0: enable only after the documented sandbox acceptance and runtime setup.
AUTH_ENABLED=false
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
AUTH0_AUTH_BINDINGS=[]
