# Runtime values are stored in AWS Secrets Manager, not in Git or tfvars.
APP_ENV=staging
SERVICE_MODE=live
PUBLIC_API_URL=https://staging.beaconandbold.com
DATABASE_URL=
REDIS_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Optional until P1-12 observability is implemented:
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Only after P1-8 approval and P1-9 model routing:
OPENAI_API_KEY=
XAI_API_KEY=

# Auth0: enable only after the documented sandbox acceptance and runtime setup.
AUTH_ENABLED=false
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
AUTH0_AUTH_BINDINGS=[]
