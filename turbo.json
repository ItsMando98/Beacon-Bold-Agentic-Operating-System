{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "APP_ENV",
    "SERVICE_MODE",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
