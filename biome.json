{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.next",
      "!!**/dist",
      "!!**/migration-dist",
      "!!**/.cache",
      "!!**/.turbo",
      "!!**/storybook-static",
      "!!**/node_modules",
      "!!**/playwright-report",
      "!!**/test-results",
      "!**/next-env.d.ts",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/deploy-staging.mjs", "scripts/migrate.mjs"],
      "linter": {
        "rules": { "suspicious": { "noUndeclaredEnvVars": "off" } }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
